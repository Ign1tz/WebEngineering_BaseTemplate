{
  "name": "webengineering-workspace",
  "version": "1.0.0",
  "description": "This repository is designed as the foundation for coding playgrounds in the Web Engineering course. It offers a structured space for experimenting with and mastering various web development technologies and practices. \r The project is based on [this](https://developer.mozilla.org/en-US/docs/Learn/Accessibility/Accessibility_troubleshooting) repository from MDN.",
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces",
    "dev": "docker compose up --build --watch",
    "prepare": "husky",
    "test": "npm test --workspace apps/api"
  },
  "lint-staged": {
    "apps/web/src/**/*.{js,jsx,ts,tsx}": [
      "npm exec --workspace apps/web -- eslint --fix",
      "npm exec --workspace apps/web -- prettier --write"
    ],
    "apps/api/src/**/*.ts": [
      "npm exec --workspace apps/api -- eslint --fix",
      "npm exec --workspace apps/api -- prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ign1tz/WebEngineering_BaseTemplate.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Ign1tz/WebEngineering_BaseTemplate/issues"
  },
  "homepage": "https://github.com/Ign1tz/WebEngineering_BaseTemplate#readme",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ]
}
